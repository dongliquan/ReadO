vendor/monaco/
vendor/marked.min.js
vendor/fonts/

# IDE
.idea/
.vscode/
*.swp

# OS
Thumbs.db
.DS_Store

# Optional preview image (regenerated at build time)
icon-preview.png

# Logs
logs/
*.log
